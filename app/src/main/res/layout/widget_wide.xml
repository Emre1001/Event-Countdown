<?xml version="1.0" encoding="utf-8"?>
<!-- Generiert für wide: gleiche IDs in klein/breit, nur Größen unterscheiden sich. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Countdown.Widget">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/units"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/unit_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:orientation="vertical">

                <ViewFlipper
                    android:id="@+id/flip_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:inAnimation="@anim/widget_in"
                    android:outAnimation="@anim/widget_out"
                    android:measureAllChildren="false">

                    <TextView
                        android:id="@+id/num_days_a"
                        style="@style/WidgetNumber"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/num_days_b"
                        style="@style/WidgetNumber"
                        android:textSize="44sp" />
                </ViewFlipper>

                <TextView
                    android:id="@+id/lbl_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/unit_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:orientation="vertical">

                <ViewFlipper
                    android:id="@+id/flip_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:inAnimation="@anim/widget_in"
                    android:outAnimation="@anim/widget_out"
                    android:measureAllChildren="false">

                    <TextView
                        android:id="@+id/num_hours_a"
                        style="@style/WidgetNumber"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/num_hours_b"
                        style="@style/WidgetNumber"
                        android:textSize="44sp" />
                </ViewFlipper>

                <TextView
                    android:id="@+id/lbl_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/unit_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp"
                android:orientation="vertical">

                <ViewFlipper
                    android:id="@+id/flip_minutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:inAnimation="@anim/widget_in"
                    android:outAnimation="@anim/widget_out"
                    android:measureAllChildren="false">

                    <TextView
                        android:id="@+id/num_minutes_a"
                        style="@style/WidgetNumber"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/num_minutes_b"
                        style="@style/WidgetNumber"
                        android:textSize="44sp" />
                </ViewFlipper>

                <TextView
                    android:id="@+id/lbl_minutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>

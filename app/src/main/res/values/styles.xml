<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Countdown" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="PreviewNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/f_sans_300</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="PreviewRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/f_sans_600</item>
        <item name="android:textColor">#FFEDEDEF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="PreviewLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/f_sans_600</item>
        <item name="android:textColor">#FF7D9CC4</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
